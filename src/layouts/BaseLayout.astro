---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Free, hands-on STEM workshops and coding programs for K–12 students in the South Bay.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101A47" />
    <link rel="icon" href="/SBSALOGO.png" type="image/png" />
    <link rel="stylesheet" href="/design-system/styles.css" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  .design-image { display: block; width: 100%; height: 100%; object-fit: cover; }
  .design-button { font-family: var(--font-display); font-weight: 700; border-radius: 0; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; font-size: 16px; text-decoration: none; transition: transform var(--duration-fast) var(--ease-standard); }
  .design-button:hover { transform: translateY(-1px); text-decoration: none; }
  .carousel-slide { position: absolute; inset: 0; opacity: 0; pointer-events: none; transition: opacity .2s; }
  .carousel-slide.is-active { opacity: 1; pointer-events: auto; }
  .calendar-nav { background: transparent; border: 0; color: #fff; font-size: 22px; line-height: 1; cursor: pointer; padding: 4px 12px; }
  .document-card:hover { transform: translateY(-1px); box-shadow: var(--shadow-md) !important; }
</style>
